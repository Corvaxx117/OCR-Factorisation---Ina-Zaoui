{% if pagination.totalPages > 1 %}
    <nav aria-label="Pagination">
        <ul class="pagination justify-content-center">
            {% if pagination.page > 1 %}
                <li class="page-item">
                    <a class="page-link" href="{{ path(route, {page: 1}) }}">Première page</a>
                </li>
                <li class="page-item">
                    <a class="page-link" href="{{ path(route, {page: pagination.page - 1}) }}">Précédent</a>
                </li>
            {% endif %}

            {% for pageNumber in range(max(1, pagination.page - 3), min(pagination.totalPages, pagination.page + 3)) %}
                <li class="page-item {% if pageNumber == pagination.page %}active{% endif %}">
                    <a class="page-link" href="{{ path(route, {page: pageNumber}) }}">{{ pageNumber }}</a>
                </li>
            {% endfor %}

            {% if pagination.page < pagination.totalPages %}
                <li class="page-item">
                    <a class="page-link" href="{{ path(route, {page: pagination.page + 1}) }}">Suivant</a>
                </li>
                <li class="page-item">
                    <a class="page-link" href="{{ path(route, {page: pagination.totalPages}) }}">Dernière page</a>
                </li>
            {% endif %}
        </ul>
    </nav>
{% endif %}