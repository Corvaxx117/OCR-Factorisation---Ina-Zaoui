{% extends 'base.html.twig' %}

{% block body %}
    <div class="container-fluid">
        <div class="row">
            <nav class="col-md-3 col-lg-2 d-none d-md-block bg-dark sidebar min-vh-100 p-4">
                <div class="position-sticky">
                    <h1 class="text-white">Admin</h1>
                    <ul class="nav flex-column">
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('home') }}"><i class="bi bi-arrow-left-circle me-2"></i>Retour au site</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('admin_media_index') }}">
                                <i class="bi bi-images me-2"></i>Medias
                            </a>
                        </li>
                        {% if is_granted('ROLE_ADMIN') %}
                            <li class="nav-item">
                                <a class="nav-link" href="{{ path('admin_album_index') }}">
                                    <i class="bi bi-collection me-2"></i>Albums
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="{{ path('admin_guest_index') }}">
                                    <i class="bi bi-people me-2"></i>Invités
                                </a>
                            </li>
                        {% endif %}
                        <li class="nav-item mt-4">
                            <a class="nav-link text-danger" href="{{ path('admin_logout') }}"><i class="bi bi-box-arrow-right me-2"></i>Déconnexion</a>
                        </li>
                    </ul>
                </div>
            </nav>
            <main class="col-md-9 ms-sm-auto col-lg-10 p-4">
                {% include '_flashes.html.twig' %}
                {% block admin %}{% endblock %}
            </main>
        </div>
    </div>
{% endblock %}